# =============================================================================
# KisanSetu Environment Configuration (SIH Problem Statement 26132)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase Cloud or Local Docker / SQLite)
# -----------------------------------------------------------------------------
# For Supabase Cloud PostgreSQL (Recommended for Team Collaboration):
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# For Local PostGIS Docker Container (Offline Development):
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/kisansetu_db

# For Quick Local SQLite (Zero Setup):
# DATABASE_URL=sqlite:///database.db

# -----------------------------------------------------------------------------
# 2. SUPABASE STORAGE & REALTIME CONFIGURATION
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_BUCKET_NAME=crop-images

# -----------------------------------------------------------------------------
# 3. SECURITY, AUTHENTICATION & CORS
# -----------------------------------------------------------------------------
# In production, generate a secure random 256-bit string (e.g. openssl rand -hex 32)
SECRET_KEY=your-secure-jwt-secret-key-min-32-chars-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256
ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://prze8969.github.io

# -----------------------------------------------------------------------------
# 4. WHATSAPP BUSINESS CLOUD API
# -----------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=kisan_setu_whatsapp_verify_token
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# -----------------------------------------------------------------------------
# 5. GEOSPATIAL & AI SETTINGS
# -----------------------------------------------------------------------------
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here
YOLO_MODEL_PATH=app/core/ml_models/yolov8_agriculture_weights.pt
CONFIDENCE_THRESHOLD=0.50

# -----------------------------------------------------------------------------
# 6. FRONTEND API CONFIGURATION (Standardized across all components)
# -----------------------------------------------------------------------------
# For local development: http://localhost:8000
# For production (e.g. GitHub Pages / Vercel): https://your-backend-domain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
NEXT_PUBLIC_ENABLE_FPO_DEMO=true
